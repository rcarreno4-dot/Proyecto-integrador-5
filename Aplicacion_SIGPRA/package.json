{
  "name": "aplicacion-sigpra",
  "version": "1.0.0",
  "description": "Orquestador de Microservicios SIGPRA",
  "main": "gateway/index.js",
  "scripts": {
    "start:gateway": "node gateway/index.js",
    "start:auth": "node microservices/auth-service/src/index.js",
    "start:data": "node microservices/data-service/src/index.js",
    "dev": "concurrently \"npm run start:gateway\" \"npm run start:auth\" \"npm run start:data\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
